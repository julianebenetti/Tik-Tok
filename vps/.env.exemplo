# Copie este arquivo pra .env na raiz do projeto e preencha.
# Depois rode: chmod 600 .env
# O .env está no .gitignore e NUNCA deve ir pro repositório.

# Chave da API do Kalodata (Centro Aberto > Conta > Gerar chave).
# Aparece uma vez só; gerar outra invalida esta na hora.
KALODATA_KEY=

# Nome do cabeçalho que leva a chave. Descubra rodando:
#   python3 kalodata-api.py --descobrir-cabecalho
KALODATA_HEADER=secret-key

# Supabase. A chave TEM que ser a service_role, não a anônima —
# a anônima não tem permissão de escrever nas tabelas do sync.
SUPABASE_URL=https://tkxkrbdvcctoajuigvvv.supabase.co
SUPABASE_KEY=

# ID da categoria de moda feminina. Descubra rodando:
#   python3 kalodata-api.py --categorias --nivel 1
CATEGORIA_MODA=
